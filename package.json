{
  "name": "neutron-browser",
  "version": "1.11.2",
  "description": "一款基于 Electron 的现代 PC 级浏览器，具备多标签页、书签管理、历史记录、下载管理等核心功能",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "npm run build:ts && electron .",
    "dev": "npm run build:ts && electron . --dev",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:ts && node scripts/test-storage.js && node scripts/test-tracking-protection.js",
    "build:ts": "node scripts/copy-assets.js && tsc",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icons.ps1",
    "build:settings": "tailwindcss -i ./settings-input.css -o ./src/renderer/pages/settings.css --minify",
    "build:ui": "tailwindcss -i ./ui-input.css -o ./src/renderer/ui.css --minify",
    "build:styles": "npm run build:settings && npm run build:ui",
    "build": "npm run build:styles && npm run build:ts && electron-builder",
    "build:win": "npm run icons && npm run build:styles && npm run build:ts && electron-builder --win",
    "build:installer": "npm run build:styles && npm run build:ts && powershell -NoProfile -ExecutionPolicy Bypass -File build-installer.ps1",
    "build:mac": "npm run build:styles && npm run build:ts && electron-builder --mac",
    "build:linux": "npm run build:styles && npm run build:ts && electron-builder --linux",
    "lint": "eslint src/"
  },
  "author": "Neutron Browser Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.56.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9",
    "nodemailer": "^9.0.5"
  },
  "build": {
    "appId": "com.neutron.browser",
    "productName": "Neutron Browser",
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "icon/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icons/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icons/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icons"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Neutron Browser",
      "installerSidebar": "assets/installer/installerSidebar.bmp",
      "uninstallerSidebar": "assets/installer/installerSidebar.bmp",
      "installerHeader": "assets/installer/installerHeader.bmp",
      "include": "assets/installer/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "2818194829",
      "repo": "neutron-browser",
      "releaseType": "release"
    }
  }
}
